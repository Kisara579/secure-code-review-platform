# ==================================================
# WINDOWS DEVELOPMENT: Supabase PostgreSQL
# ==================================================
# DATABASE_URL: Transaction-mode pooler for application queries.
# DIRECT_URL: Session-mode pooler for Prisma CLI/migrations.
# Use the connection strings from your Supabase dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ==================================================
# WINDOWS DEVELOPMENT: Upstash Redis
# ==================================================
# Use the actual Redis URL provided by Upstash.
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379"

# ==================================================
# DOCKER: PostgreSQL and Redis
# ==================================================
# Configure these values in .env.docker for Docker Compose.
# Docker uses its internal PostgreSQL and Redis services.
# Do not use the Windows Supabase or Upstash URLs here.
#
# POSTGRES_PASSWORD="replace_with_a_strong_random_password"
# DATABASE_URL="postgresql://secure_review_user:replace_with_a_strong_random_password@postgres:5432/secure_review"
# REDIS_URL="redis://redis:6379"

# ==================================================
# BETTER AUTH
# ==================================================
# Generate a secret locally using:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace_with_a_generated_random_secret"
BETTER_AUTH_URL="http://localhost:3000"

# ==================================================
# GOOGLE OAUTH: Optional
# Configure when Google sign-in is implemented.
# ==================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==================================================
# GITHUB OAUTH: Optional
# Configure when GitHub sign-in is implemented.
# ==================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ==================================================
# GITLAB OAUTH: Optional
# Configure when GitLab sign-in is implemented.
# ==================================================
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""


GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=


GITLAB REPOSITORY ACCESS (separate OAuth flow)

Create a separate GitLab OAuth application for repository access.

==================================================

GITLAB_REPOSITORY_CLIENT_ID=""
GITLAB_REPOSITORY_CLIENT_SECRET=""
GITLAB_REPOSITORY_REDIRECT_URI=""
Generate a cryptographically random 32-byte key encoded as 64 hex characters.
GITLAB_TOKEN_ENCRYPTION_KEY=""
# ==================================================
# EMAIL: Future registration verification and recovery
# Configure when email delivery is implemented.
# ==================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""









