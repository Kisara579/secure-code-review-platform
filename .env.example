
# SecureReview AI - Environment Template
# Copy the relevant values into your local .env or .env.docker.
# Never commit files containing real credentials.

# ==================================================
# WINDOWS DEVELOPMENT: Supabase PostgreSQL
# ==================================================
# Use your actual Supabase connection string.
# Keep the correct host, port, database, and SSL parameters.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# ==================================================
# WINDOWS DEVELOPMENT: Upstash Redis
# ==================================================
# Use the actual Redis URL provided by Upstash.
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379"

# ==================================================
# DOCKER: PostgreSQL and Redis
# ==================================================
# Uncomment/use these values in .env.docker instead
# of the Windows DATABASE_URL and REDIS_URL.
#
# POSTGRES_PASSWORD=replace_with_a_strong_random_password
# DATABASE_URL="postgresql://secure_review_user:replace_with_a_strong_random_password@postgres:5432/secure_review"
# REDIS_URL="redis://redis:6379"

# ==================================================
# AUTH.JS v5
# ==================================================
AUTH_SECRET="replace_with_a_generated_random_secret"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth for application sign-in
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# GitLab OAuth for application sign-in
AUTH_GITLAB_ID=""
AUTH_GITLAB_SECRET=""

# ==================================================
# EMAIL: Future registration and account recovery
# Configure when email delivery is implemented.
# ==================================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
