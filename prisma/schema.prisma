generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Review {
  id String @id @default(uuid())
  provider String
  owner String
  repositoryName String
  repositoryUrl String
  branch String
  status ReviewStatus
  createdAt DateTime @default(now())
}