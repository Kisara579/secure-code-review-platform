generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Review {
  id             String       @id @default(uuid()) 
  provider       String
  owner          String
  repositoryName String
  repositoryUrl  String
  branch         String
  status         ReviewStatus @default(QUEUED)
  createdAt      DateTime     @default(now())

  findings       Finding[]
}

model Finding {
  id         String   @id @default(uuid())
  reviewId   String
  source     String
  ruleId     String?
  severity   String
  message    String
  filePath   String?
  startLine  Int?
  endLine    Int?
  details    Json?
  createdAt  DateTime @default(now())

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}